VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# Solo para los tests E2E (npm run test:e2e). Sin prefijo VITE_ a proposito:
# asi Vite no las inyecta en el bundle que ve el navegador. Necesitan una
# cuenta con rol admin en tu instancia.
E2E_EMAIL=admin@tu-proyecto.com
E2E_PASSWORD=tu-password-de-admin

# Cuenta con rol 'tecnico'. Los E2E de permisos usan esta para comprobar que
# un tecnico NO puede borrar ordenes y solo ve las suyas.
E2E_TECNICO_EMAIL=tecnico@tu-proyecto.com
E2E_TECNICO_PASSWORD=tu-password
E2E_OPERADOR_EMAIL=operador@tu-proyecto.com
E2E_OPERADOR_PASSWORD=tu-password

# Ponelo en 1 solo despues de correr interno/aplicar_rls_ordenes.sql en el SQL
# Editor. Habilita los tests que dependen de las funciones actualizar_orden y
# completar_orden, que todavia no existen en la base.
E2E_PERMISOS=0
